/* Interactive cards need the narrow timeline's full tile width. Keep metadata
   above and receipts below the card instead of reserving both inline gutters. */
.mx_RoomView_body[data-layout="group"] .mx_MessagePanel_narrow .mx_EventTile:has(.mx_InteractiveUiBody) {
    --event-tile-content-inline-end: 0;

    .mx_EventTile_line {
        margin-inline-end: 0;
        padding-inline-start: 0;
        padding-block-start: var(--cpd-space-12x);
        padding-block-end: var(--cpd-space-8x);
    }
}
